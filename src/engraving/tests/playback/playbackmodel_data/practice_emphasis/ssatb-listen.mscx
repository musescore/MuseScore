    <metaTag name="workTitle">SSATB practice listen</metaTag>
    <!-- Part 1: Soprano/Alto share one treble staff (closed score) -->
    <Part id="1">
      <Staff id="1">
        <StaffType group="pitched">
          <name>stdNormal</name>
        </StaffType>
      </Staff>
      <trackName>Women</trackName>
      <Instrument id="soprano">
        <longName>S/A</longName>
        <trackName>Women</trackName>
        <minPitchP>60</minPitchP>
        <maxPitchP>84</maxPitchP>
        <instrumentId>voice.soprano</instrumentId>
        <clef>G</clef>
        <Channel>
          <program value="52"/>
        </Channel>
      </Instrument>
    </Part>
    <!-- Part 2: Tenor/Bass share one bass staff -->
