    </Part>

    <!-- Staff 1, measure 1 -->
    <Staff id="1">
      <Measure>
        <voice>
          <KeySig><concertKey>0</concertKey></KeySig>
          <TimeSig><sigN>4</sigN><sigD>4</sigD></TimeSig>
          <Tempo><tempo>1</tempo><text><sym>metNoteQuarterUp</sym> = 60</text></Tempo>
          <Dynamic><subtype>mf</subtype><velocity>80</velocity></Dynamic>
          <!-- Voice 1 (stems up): Soprano 1 + Soprano 2 as ONE chord, two noteheads.
               Beat 1-2: they divide (E5 / C5). Beat 3-4: unison D5 (shared note). -->
          <Chord>
            <durationType>half</durationType>
            <StemDirection>up</StemDirection>
            <Note><pitch>76</pitch><tpc>18</tpc></Note><!-- S1: E5 -->
            <Note><pitch>72</pitch><tpc>14</tpc></Note><!-- S2: C5 -->
          </Chord>
          <Chord>
            <durationType>half</durationType>
            <StemDirection>up</StemDirection>
            <Note><pitch>74</pitch><tpc>16</tpc></Note><!-- S1+S2 unison: D5 -->
          </Chord>
          <BarLine><subtype>end</subtype></BarLine>
        </voice>
        <voice>
          <!-- Voice 2 (stems down): Alto -->
          <Chord>
            <durationType>half</durationType>
            <StemDirection>down</StemDirection>
            <Note><pitch>67</pitch><tpc>15</tpc></Note><!-- A: G4 -->
          </Chord>
          <Chord>
            <durationType>half</durationType>
            <StemDirection>down</StemDirection>
            <Note><pitch>65</pitch><tpc>13</tpc></Note><!-- A: F4 -->
          </Chord>
        </voice>
      </Measure>
