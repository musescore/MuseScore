import QtQuick
import QtTest
import "../../qml/MuseScore/NotationScene/drawing/core/Repeat.js" as R
import "../../qml/MuseScore/NotationScene/drawing/core/Context.js" as A
import "../../qml/MuseScore/NotationScene/drawing/core/Vector.js" as V
TestCase {
 name: "RepeatAndObjectLinks"
 function line(id,x,y){return {drawId:id,kind:"line",name:id,commands:[["M",x||0,y||0],["L",(x||0)+100,y||0]],style:V.style("#123456","none",2,1)};}
 function editor(){var guide=line("guide"),source={drawId:"source",name:"Note",kind:"rectangle",commands:[["M",0,30],["L",10,30],["L",10,40],["L",0,40],["Z"]],style:V.style("#123456","#123456",1,1)};return {shapes:[guide,source],bindings:[],repeatSession:{pathId:"guide",sourceId:"source",groupId:"copies"},repeatCount:3,repeatRotation:0,repeatFollow:true,requestPaint:function(){},gestureStarting:function(){},gestureFinished:function(){},remember:function(){this.saved=V.copy({shapes:this.shapes,bindings:this.bindings});},changed:function(){R.follow(this);},setSelection:function(a,p){this.selected=p;this.selectedShapes=a;},autoLink:function(){}};}
 function copies(e){return e.shapes.filter(function(s){return !!s.repeatLink;});}
 function center(s){return s.commands[5];}
 function test_distribution(){var e=editor(),original=JSON.stringify(e.shapes[1]);R.rebuild(e);var a=copies(e);compare(a.length,3);compare(center(a[0])[1],0);compare(center(a[1])[1],50);compare(center(a[2])[1],100);compare(a[0].name,"Note 1");compare(a[2].name,"Note 3");compare(JSON.stringify(e.shapes[1]),original);a.forEach(function(s){compare(V.linkedHandles(s,[],0).length,1);compare(s.anchorCommand,5);verify(s.svgSource.indexOf("svg")>=0);});}
 function test_mutated_path_invalidates_trace(){var commands=[["M",0,0],["L",10,0]];compare(R.trace(commands).length,10);commands[1][1]=30;compare(R.trace(commands).length,30);}
 function test_curve_length(){var path=R.trace([["M",0,0],["C",0,100,100,100,100,0]]);verify(path.length>190);var p=R.at(path,0.5);verify(Math.abs(p.x-50)<0.01);verify(Math.abs(p.y-75)<0.01);compare(R.trace([["M",0,0],["L",20,0],["M",1000,0],["L",1020,0]]).length,40);}
 function test_real_time_and_rigid(){var e=editor();R.rebuild(e);var before=copies(e),w=Math.hypot(before[1].svgMatrix[0],before[1].svgMatrix[1]);e.shapes[0]=Object.assign({},e.shapes[0],{commands:[["M",10,20],["L",10,220]]});R.follow(e);var a=copies(e);compare(center(a[1])[1],10);compare(center(a[1])[2],120);verify(Math.abs(Math.hypot(a[1].svgMatrix[0],a[1].svgMatrix[1])-w)<1e-7);verify(Math.abs(a[1].svgMatrix[0])<1e-7);}
 function test_individual_move_and_count_reset(){var e=editor();R.rebuild(e);var before=e.shapes.slice(),after=e.shapes.slice();after[3]=V.translate(after[3],7,9);R.captureMoves(before,after,[3]);e.shapes=after;R.follow(e);compare(center(e.shapes[3])[1],57);compare(center(e.shapes[2])[1],0);compare(center(e.shapes[4])[1],100);e.repeatCount=4;R.rebuild(e);compare(copies(e).length,4);compare(copies(e)[1].repeatLink.dx,0);verify(Math.abs(center(copies(e)[1])[1]-100/3)<1e-7);}
 function test_detach_preserves_neighbors(){var e=editor();R.rebuild(e);var a=copies(e),id=a[1].drawId,first=JSON.stringify(a[0]),last=JSON.stringify(a[2]);A.moveObjects(e,[id],{indices:[1]},"after");var sh=e.shapes.find(function(s){return s.drawId===id;});verify(!sh.repeatLink);verify(!sh.selectionGroup);compare(JSON.stringify(e.shapes.find(function(s){return s.drawId===a[0].drawId;})),first);compare(JSON.stringify(e.shapes.find(function(s){return s.drawId===a[2].drawId;})),last);compare(e.saved.shapes.find(function(s){return s.drawId===id;}).repeatLink.guideId,"guide");}
 function test_group_reorder_and_ids(){var e=editor();A.moveObjects(e,["guide"],{indices:[1]},"inside");verify(e.shapes[0].selectionGroup);compare(e.shapes[0].selectionGroup,e.shapes[1].selectionGroup);var ids=e.shapes.map(function(s){return s.drawId;}).sort().join();compare(ids,"guide,source");compare(A.nextName([{name:"Note 1"},{name:"Note 3"}],"Note"),"Note 4");}
 function test_single_node_is_translation(){var e={shapes:[line("follower"),line("target",100,200)],bindings:[{shape:0,command:0,field:1,scale:2,offsetX:0,offsetY:0}]};e.shapes[0].nodeLinks=[{drawId:"target",command:0,field:1,ownCommand:0,ownField:1,dx:0,dy:0}];A.followPoints(e);compare(e.shapes[0].commands[0][1],100);compare(e.shapes[0].commands[1][1],200);compare(e.shapes[0].commands[0][2],200);compare(e.shapes[0].commands[1][2],200);compare(A.linkedNodes(e.shapes[0],e.bindings,0).length,1);}
 function test_multiple_nodes_deform(){var e={shapes:[line("follower"),line("target",0,50)],bindings:[{shape:0,command:0,field:1,scale:2,offsetX:0,offsetY:0},{shape:0,command:1,field:1,scale:2,offsetX:0,offsetY:0}]};e.shapes[0].nodeLinks=[{drawId:"target",command:0,field:1,ownCommand:0,ownField:1,dx:0,dy:0}];A.followPoints(e);compare(e.shapes[0].commands[0][2],50);compare(e.shapes[0].commands[1][2],0);compare(A.linkedNodes(e.shapes[0],e.bindings,0).length,2);}
 function test_repeater_serialization(){var e=editor();R.rebuild(e);var loaded=V.readDocument(V.document(e.shapes));compare(loaded.length,5);compare(loaded[3].repeatLink.u,0.5);compare(loaded[3].drawId,e.shapes[3].drawId);compare(loaded[3].selectionGroup,"copies");}
}
