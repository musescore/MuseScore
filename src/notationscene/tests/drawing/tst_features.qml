import QtQuick
import QtTest
import "../../qml/MuseScore/NotationScene/drawing/core/Parametric.js" as P
import "../../qml/MuseScore/NotationScene/drawing/core/Context.js" as A
import "../../qml/MuseScore/NotationScene/drawing/core/Vector.js" as V
TestCase {
 name:"DrawingExpansion"
 function test_shapes(){["polygon","star","diamond","cross","rounded-rectangle"].forEach(function(k){var s=P.create(k,{x:0,y:0},{x:120,y:80},V.style("#123456","none",2,1),{sides:7});verify(s.commands.length>3);compare(s.commands[s.commands.length-1][0],"Z");verify(V.svg([s]).indexOf("NaN")<0);});}
 function test_wave(){var s=P.create("wave",{x:0,y:0},{x:400,y:0},V.style("#000000","none",2,1),{amplitude:10,period:40});compare(s.wave.stops.length,3);compare(s.commands.length,243);var h=P.handles(s,1)[0],after=P.adjust(s,h,0,12);compare(after.wave.stops[0].amplitude,22);compare(s.wave.stops[0].amplitude,10);var moved=V.translate(s,5,7);compare(moved.wave.a.x,5);compare(moved.wave.a.y,7);var doc=V.readDocument(V.document([after]));compare(doc[0].wave.stops[0].amplitude,22);}
 function test_style_inheritance(){var s={style:V.style("#123456","none",2,1),commands:[["M",10,20],["L",30,20],["L",50,20],["L",70,20]],segmentStyles:[{command:1,style:{width:5,linePattern:"dash"}},{command:2,style:{width:3}}]};compare(A.effective(s,0).width,2);compare(A.effective(s,1).width,5);compare(A.effective(s,2).width,3);compare(A.effective(s,3).linePattern,"dash");A.ranges(s);var parts=V.paintedParts(s);compare(parts[1].commands[0][0],"M");compare(parts[1].commands[0][1],30);verify(V.svg([s]).indexOf('stroke-dasharray="20 10"')>=0);var added=V.insertPoint(s,1,0.5);compare(added.segmentStyles[0].command,2);compare(added.segmentStyles[1].command,3);}
 function test_reorder(){var e={shapes:[{drawId:"a"},{drawId:"b"},{drawId:"c"}],selected:0,bindings:[{shape:0,command:1}],selectionIndices:function(){return [this.selected];},remember:function(){},setSelection:function(a,p){this.selected=p;},changed:function(){}};A.reorder(e,true);compare(e.shapes[2].drawId,"a");compare(e.bindings[0].shape,2);compare(e.selected,2);A.reorder(e,false);compare(e.shapes[0].drawId,"a");compare(e.bindings[0].shape,0);}
 function test_zero_amplitude(){var sh=P.create("wave",{x:0,y:0},{x:100,y:0},V.style("#000000","none",2,1),{amplitude:0,period:40});verify(sh.commands.every(function(c){return c.length<3||c[2]===0;}));}
 function test_closed_style_ranges(){var s={style:V.style("#123456","#abcdef",2,1),commands:[["M",10,10],["L",50,10],["L",50,50],["Z"]],segmentStyles:[{command:1,style:{width:7}}]};A.ranges(s);var parts=V.paintedParts(s);compare(parts[0].style.stroke,"none");compare(parts[2].commands[parts[2].commands.length-1][0],"L");compare(parts[2].commands[parts[2].commands.length-1][1],10);}
 function test_page_groups(){var e={paintRegion:{x:0,y:0,width:100,height:100},anchorPageAt:function(){return 0;},shapes:[{kind:"line",ownerPage:0,commands:[["M",0,0]]},{kind:"star",ownerPage:0,selectionGroup:"g",commands:[["M",0,0]]},{kind:"polygon",ownerPage:0,selectionGroup:"g",commands:[["M",0,0]]},{kind:"wave",ownerPage:1,commands:[["M",0,0]]},{kind:"fragment",derived:true,ownerPage:0,commands:[["M",0,0]]}]};var rows=A.rows(e);compare(rows.length,2);verify(rows[0].group);compare(rows[0].children.length,2);compare(rows[0].children[0].index,2);}
 function test_point_links(){var e={shapes:[{drawId:"a",commands:[["M",10,20]],nodeLinks:[{drawId:"b",command:0,field:1,ownCommand:0,ownField:1,dx:2,dy:3}]},{drawId:"b",commands:[["M",100,200]]}],bindings:[{shape:0,command:0,field:1,scale:2,offsetX:0,offsetY:0}]};verify(A.reaches(e.shapes,"a","b"));verify(!A.reaches(e.shapes,"b","a"));A.followPoints(e);compare(e.shapes[0].commands[0][1],102);compare(e.shapes[0].commands[0][2],203);compare(e.bindings[0].offsetX,46);A.remapLinks(e,"b",function(c){return c+1;});compare(e.shapes[0].nodeLinks[0].command,1);}
 function test_parametric_adjustment(){var sh=P.create("star",{x:10,y:20},{x:110,y:120},V.style("#123456","none",2,1),{sides:5,innerRatio:0.4});var original=JSON.stringify(sh),controls=P.handles(sh,1);compare(controls.length,2);var changed=P.adjust(sh,controls[0],24,0,1);compare(changed.parametric.sides,7);compare(JSON.stringify(sh),original);var moved=V.translate(sh,30,40),edited=P.rebuild(moved,{sides:6,innerRatio:0.4});compare(edited.parametric.matrix[4],30);compare(edited.parametric.matrix[5],40);compare(edited.commands[0][1],90);compare(edited.commands[0][2],60);}
}
